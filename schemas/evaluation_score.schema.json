{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mashup-Benchmark evaluation score record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "eval_id",
    "run_id",
    "task_id",
    "scores"
  ],
  "properties": {
    "eval_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[0-9]{3}$"
    },
    "method": {
      "type": "string"
    },
    "method_version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "skipped",
        "failed"
      ]
    },
    "judge": {
      "type": [
        "object",
        "null"
      ]
    },
    "scores": {
      "type": "object",
      "properties": {
        "IF": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "BCS": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "AEC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "VQ": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "TC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "NC": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "OQ": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5
        },
        "Quality": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "metric_details": {
      "type": "object"
    },
    "cost": {
      "type": "object"
    },
    "efficiency": {
      "type": "object"
    },
    "rationale": {
      "type": [
        "object",
        "string"
      ]
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "matched_prompt_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_prompt_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_quality_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transition_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "narrative_issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "length_issue": {
          "enum": [
            "none",
            "too_short",
            "too_long"
          ]
        },
        "uncertain_observations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
